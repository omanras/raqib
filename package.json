{
  "name": "dawr",
  "version": "0.0.0",
  "private": true,
  "description": "Dawr: a transparent, verifiable savings-circle (jam'iyya / ROSCA) web application. Records money; never moves it.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p server/tsconfig.json && node server/scripts/copy-assets.mjs",
    "start": "node server/dist/server/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gate": "tools/gate.sh"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "preact": "^10.29.8",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
