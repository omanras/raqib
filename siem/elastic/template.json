{
  "index_patterns": [
    "raqib-events*"
  ],
  "priority": 200,
  "template": {
    "settings": {
      "index": {
        "default_pipeline": "raqib-event-1"
      }
    },
    "mappings": {
      "date_detection": false,
      "dynamic_templates": [
        {
          "strings": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        }
      ],
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "message": {
          "type": "text"
        },
        "error": {
          "properties": {
            "message": {
              "type": "text"
            }
          }
        },
        "event": {
          "properties": {
            "original": {
              "type": "keyword",
              "index": false,
              "doc_values": false
            },
            "ingested": {
              "type": "date"
            },
            "severity": {
              "type": "long"
            },
            "id": {
              "type": "keyword"
            },
            "action": {
              "type": "keyword"
            },
            "kind": {
              "type": "keyword"
            }
          }
        },
        "host": {
          "properties": {
            "name": {
              "type": "keyword"
            }
          }
        },
        "observer": {
          "properties": {
            "product": {
              "type": "keyword"
            },
            "version": {
              "type": "keyword"
            }
          }
        },
        "rule": {
          "properties": {
            "id": {
              "type": "keyword"
            },
            "category": {
              "type": "keyword"
            }
          }
        },
        "threat": {
          "properties": {
            "technique": {
              "properties": {
                "id": {
                  "type": "keyword"
                }
              }
            }
          }
        },
        "process": {
          "properties": {
            "pid": {
              "type": "long"
            },
            "name": {
              "type": "keyword"
            }
          }
        },
        "displaced": {
          "type": "flattened"
        },
        "raqib": {
          "properties": {
            "schema": {
              "type": "keyword"
            },
            "about": {
              "type": "keyword"
            },
            "state": {
              "type": "keyword"
            },
            "n": {
              "type": "long"
            },
            "rev": {
              "type": "long"
            },
            "severity": {
              "type": "keyword"
            },
            "prev": {
              "type": "keyword"
            },
            "unknown_keys": {
              "type": "keyword"
            },
            "watch": {
              "properties": {
                "run": {
                  "type": "keyword"
                },
                "mode": {
                  "type": "keyword"
                },
                "platform": {
                  "type": "keyword"
                },
                "beat": {
                  "type": "double"
                }
              }
            },
            "rule": {
              "properties": {
                "kind": {
                  "type": "keyword"
                },
                "fp_budget": {
                  "type": "double"
                }
              }
            },
            "subject": {
              "type": "flattened"
            },
            "evidence": {
              "type": "flattened"
            },
            "hole": {
              "type": "flattened"
            },
            "knocked": {
              "type": "flattened"
            },
            "result": {
              "type": "flattened"
            },
            "counts": {
              "type": "flattened"
            }
          }
        }
      }
    }
  }
}
