{
  "finds": "The hosts where the engine's own clock has passed the latest deadline any line of the host gave (its arrival, event.ingested, and two of that line's own watch.beat; never the event's time), the nearest deadline first, at most 10000 hosts judged.",
  "request": "POST raqib-events*/_search",
  "body": {
    "size": 0,
    "query": {
      "bool": {
        "filter": [
          {
            "exists": {
              "field": "raqib.watch.beat"
            }
          },
          {
            "exists": {
              "field": "event.ingested"
            }
          },
          {
            "exists": {
              "field": "host.name"
            }
          }
        ]
      }
    },
    "aggs": {
      "hosts": {
        "terms": {
          "field": "host.name",
          "size": 10000,
          "order": {
            "deadline": "asc"
          }
        },
        "aggs": {
          "deadline": {
            "max": {
              "script": {
                "source": "doc['event.ingested'].value.toInstant().toEpochMilli() + (long)(2000 * doc['raqib.watch.beat'].value)"
              }
            }
          },
          "silent": {
            "bucket_selector": {
              "buckets_path": {
                "d": "deadline"
              },
              "script": "params.d < System.currentTimeMillis()"
            }
          }
        }
      }
    }
  }
}
