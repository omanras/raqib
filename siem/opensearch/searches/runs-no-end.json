{
  "finds": "The runs, by host and run, that said no watch end and whose latest deadline (a line's arrival and two of its own watch.beat, a beat counted as at most 86400 s) the engine's own clock has passed; at most 10000 runs are judged, past that bound the runs that said an end are left out first and then the runs whose deadline is oldest, and a sum_other_doc_count above 0 in the answer means lines of runs beyond the bound exist.",
  "request": "POST raqib-events*/_search",
  "body": {
    "size": 0,
    "query": {
      "bool": {
        "filter": [
          {
            "exists": {
              "field": "raqib.watch.beat"
            }
          },
          {
            "exists": {
              "field": "event.ingested"
            }
          },
          {
            "exists": {
              "field": "host.name"
            }
          },
          {
            "exists": {
              "field": "raqib.watch.run"
            }
          }
        ]
      }
    },
    "aggs": {
      "runs": {
        "multi_terms": {
          "terms": [
            {
              "field": "host.name"
            },
            {
              "field": "raqib.watch.run"
            }
          ],
          "size": 10000,
          "order": [
            {
              "ends": "asc"
            },
            {
              "deadline": "desc"
            }
          ]
        },
        "aggs": {
          "deadline": {
            "max": {
              "script": {
                "source": "doc['event.ingested'].value.toInstant().toEpochMilli() + (long)(2000 * Math.min(doc['raqib.watch.beat'].value, 86400.0))"
              }
            }
          },
          "ends": {
            "filter": {
              "bool": {
                "filter": [
                  {
                    "term": {
                      "event.action": "watch"
                    }
                  },
                  {
                    "term": {
                      "raqib.state": "end"
                    }
                  }
                ]
              }
            }
          },
          "stopped": {
            "bucket_selector": {
              "buckets_path": {
                "d": "deadline",
                "e": "ends._count"
              },
              "script": "params.e == 0 && params.d < System.currentTimeMillis()"
            }
          }
        }
      }
    }
  }
}
