# Build context for deploy/Dockerfile (BuildKit reads <Dockerfile>.dockerignore).
# Only what the build copies is sent; nothing that belongs to a machine.
*
!package.json
!package-lock.json
!tsconfig.json
!vite.config.ts
!shared/
!server/
!client/
!deploy/dbtool.mjs
!deploy/healthcheck.mjs
**/dist
**/node_modules
**/*.test.ts
**/*.test.tsx
**/*.sqlite
**/*.sqlite-*
**/.env
