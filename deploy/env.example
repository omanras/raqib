# Copy to deploy/.env (never commit it) and fill in. docs/OPERATIONS.md.

# 64 hex characters from a good random source, for example:
#   openssl rand -hex 32
# Keep it with your other secrets; changing it is described in OPERATIONS.
SESSION_SECRET=

# The address members open: https, no path. It is the origin of invite
# links and, with the bundled Caddy, the site it obtains a certificate for.
BASE_URL=https://dawr.example.org

# Optional.
# LOG_LEVEL=info
# DAWR_PORT=3000
# DAWR_IMAGE=dawr:0.1.0
# NODE_IMAGE=node:22-bookworm-slim
